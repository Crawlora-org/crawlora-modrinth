{
  "name": "crawlora/modrinth",
  "description": "Crawlora Modrinth API client with 34 endpoints for project search and metadata, versions, dependencies, collections, organizations, and file compatibility",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "modrinth",
    "modrinth-api",
    "modrinth-scraper",
    "modrinth-data",
    "modrinth-project-search-metadata",
    "modrinth-versions",
    "modrinth-dependencies",
    "modrinth-collections",
    "modrinth-organizations",
    "modrinth-file-compatibility"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Modrinth\\": "php/src/Crawlora/Modrinth/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Modrinth\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=modrinth-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-modrinth",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=modrinth-php-api-docs"
  }
}
