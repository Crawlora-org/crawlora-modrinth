{
  "name": "@crawlora-org/modrinth",
  "version": "0.1.0",
  "description": "Crawlora Modrinth API client with 34 endpoints for project search and metadata, versions, dependencies, collections, organizations, and file compatibility",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=modrinth-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-modrinth/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "modrinth", "modrinth-api", "modrinth-scraper", "modrinth-data", "modrinth-project-search-metadata", "modrinth-versions", "modrinth-dependencies", "modrinth-collections", "modrinth-organizations", "modrinth-file-compatibility"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-modrinth",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
